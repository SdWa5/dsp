{% extends 'base.html.twig' %}

{% macro item(label, dialog, hint = null) %}
    <button type="button" data-action="editor#open" data-editor-dialog-param="{{ dialog }}">{{ label }}{% if hint %}<small>{{ hint }}</small>{% endif %}</button>
{% endmacro %}

{% block body %}
    {% import 'editor/_widgets.html.twig' as w %}
    <script type="application/json" id="trackdsp-labels">{{ labels|json_encode|raw }}</script>
    <script type="application/json" id="trackdsp-defaults">{{ defaults|json_encode|raw }}</script>
    <script type="application/json" id="trackdsp-i18n">{{ i18n|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
    <div class="editor" data-controller="editor">
        <header class="editor__head">
            <div class="bar">
                <nav class="menu" aria-label="{{ 'editor.menu.label'|trans }}">
                    <div class="menu__item">
                        <button type="button" class="menu__title">{{ 'editor.menu.file'|trans }}</button>
                        <div class="menu__list">
                            <button type="button" data-action="editor#openFile">{{ 'editor.menu.open_file'|trans }}<small>{{ 'editor.menu.open_file_hint'|trans }}</small></button>
                            <button type="button" data-action="editor#saveFile">{{ 'editor.menu.save_file'|trans }}<small>{{ 'editor.menu.save_file_hint'|trans }}</small></button>
                        </div>
                    </div>
                    <div class="menu__item">
                        <button type="button" class="menu__title">{{ 'editor.menu.device'|trans }}</button>
                        <div class="menu__list">
                            {{ _self.item('editor.menu.connection'|trans, 'connect', 'editor.menu.connection_hint'|trans) }}
                            {{ _self.item('editor.menu.store'|trans, 'store') }}
                            {{ _self.item('editor.menu.recall'|trans, 'recall') }}
                            <button type="button" data-action="editor#factory">{{ 'editor.menu.factory'|trans }}</button>
                            <button type="button" data-action="editor#refresh">{{ 'editor.menu.refresh'|trans }}</button>
                            <hr>
                            {{ _self.item('editor.menu.idip'|trans, 'idip') }}
                            {{ _self.item('editor.menu.working'|trans, 'working') }}
                            {{ _self.item('editor.menu.lock'|trans, 'lock') }}
                        </div>
                    </div>
                    <div class="menu__item">
                        <button type="button" class="menu__title">{{ 'editor.menu.channels'|trans }}</button>
                        <div class="menu__list">
                            {{ _self.item('editor.menu.names'|trans, 'names') }}
                            {{ _self.item('editor.menu.link'|trans, 'link', 'editor.menu.link_hint'|trans) }}
                            {{ _self.item('editor.menu.copy'|trans, 'copy') }}
                            <hr>
                            {{ _self.item('editor.menu.sub'|trans, 'sub') }}
                            {{ _self.item('editor.menu.groups'|trans, 'groups') }}
                            <hr>
                            {{ include('editor/_linkview.html.twig', {name: 'link-placement', heading: 'menu__heading', check: 'menu__check'}) }}
                            <hr>
                            {{ include('editor/_meterview.html.twig') }}
                        </div>
                    </div>
                    <div class="menu__item">
                        <button type="button" class="menu__title">{{ 'editor.menu.tools'|trans }}</button>
                        <div class="menu__list">
                            {{ _self.item('editor.menu.tone'|trans, 'tone') }}
                            <button type="button" data-action="editor#tab" data-editor-page-param="gain">{{ 'editor.menu.riders'|trans }}<small>{{ 'editor.menu.riders_hint'|trans }}</small></button>
                            <button type="button" data-action="editor#tab" data-editor-page-param="autoeq">{{ 'editor.menu.autoeq'|trans }}<small>{{ 'editor.menu.autoeq_hint'|trans }}</small></button>
                        </div>
                    </div>
                    <div class="menu__item">
                        <button type="button" class="menu__title">{{ 'editor.menu.help'|trans }}</button>
                        <div class="menu__list">
                            {{ _self.item('editor.menu.rs232'|trans, 'help') }}
                            {{ _self.item('editor.menu.about'|trans, 'about') }}
                            <hr>
                            <span class="menu__heading">{{ 'editor.menu.language'|trans }}</span>
                            {% set chosen = app.request.cookies.get('trackdsp_locale') %}
                            {% for key, label in {auto: 'editor.menu.language_auto'|trans, en: 'English', de: 'Deutsch'} %}
                                <label class="menu__check"><input type="radio" name="language" value="{{ key }}"{{ (chosen in ['en', 'de'] ? chosen : 'auto') == key ? ' checked' }}
                                    data-action="change->editor#language"{% if key != 'auto' %} lang="{{ key }}"{% endif %}> {{ label }}</label>
                            {% endfor %}
                        </div>
                    </div>
                    <input type="file" accept=".json,.prs,application/json" hidden data-editor-target="file" data-action="change->editor#upload">
                </nav>
                <span class="bar__id" title="{{ 'editor.tip.device_id'|trans }}">{{ 'editor.bar.id'|trans }} {{ w.value('device_id') }}</span>
                <button type="button" class="theme" data-editor-target="theme" data-action="editor#theme" title="{{ 'editor.bar.theme'|trans }}">{{ 'editor.bar.theme_auto'|trans }}</button>
                <button type="button" class="online" data-editor-target="online" data-action="editor#open" data-editor-dialog-param="connect" title="{{ 'editor.tip.bar.online'|trans }}">{{ 'editor.bar.offline'|trans }}</button>
            </div>
            <div class="tabs" role="tablist" aria-label="{{ 'editor.tabs.pages'|trans }}">
                {% for page in ['gain', 'gate', 'comp', 'delay', 'matrix', 'aux', 'autoeq'] %}
                    <button type="button" role="tab" class="tab" data-editor-target="tab" data-page="{{ page }}"
                            data-action="editor#tab" data-editor-page-param="{{ page }}">{{ ('editor.tabs.' ~ page)|trans }}<span class="tab__count" hidden></span></button>
                {% endfor %}
            </div>
            <div class="chtabs" role="tablist" aria-label="{{ 'editor.tabs.channels'|trans }}" data-editor-target="chtabs">
                {% for side, prefix in {inputs: 'In', outputs: 'Out'} %}
                    {% for i in 0..7 %}
                        <button type="button" role="tab" class="chtab chtab--{{ side }}{{ 'outputs' == side and 0 == i ? ' is-split' }}" data-editor-target="tab" data-page="{{ side }}{{ i }}"
                                data-side="{{ side }}" data-index="{{ i }}"
                                data-action="editor#tab" data-editor-page-param="{{ side }}{{ i }}">
                            <b class="chtab__id">{{ prefix }}{{ i + 1 }}</b><span class="chtab__name"></span><span class="chtab__marks"></span>
                        </button>
                    {% endfor %}
                {% endfor %}
            </div>
        </header>

        <main class="editor__main">
            <div class="banner" data-editor-target="banner" hidden>
                <span data-editor-target="bannerText"></span>
                <button type="button" class="toggle" data-action="editor#open" data-editor-dialog-param="connect">{{ 'editor.menu.connection'|trans }}</button>
            </div>
            <section class="page" data-editor-target="page" data-page="gain">{{ include('editor/page/_gain.html.twig') }}</section>
            <section class="page" data-editor-target="page" data-page="gate" hidden>{{ include('editor/page/_gate.html.twig') }}</section>
            <section class="page" data-editor-target="page" data-page="comp" hidden>{{ include('editor/page/_comp.html.twig') }}</section>
            <section class="page" data-editor-target="page" data-page="delay" hidden>{{ include('editor/page/_delay.html.twig') }}</section>
            <section class="page" data-editor-target="page" data-page="matrix" hidden>{{ include('editor/page/_matrix.html.twig') }}</section>
            <section class="page" data-editor-target="page" data-page="aux" hidden>{{ include('editor/page/_aux.html.twig') }}</section>
            <section class="page" data-editor-target="page" data-page="autoeq" hidden>{{ include('editor/page/_autoeq.html.twig') }}</section>
            {% for side in ['inputs', 'outputs'] %}
                {% for i in 0..7 %}
                    <section class="page" data-editor-target="page" data-page="{{ side }}{{ i }}" hidden>
                        {{ include('editor/page/_channel.html.twig', {side: side, i: i}) }}
                    </section>
                {% endfor %}
            {% endfor %}
        </main>

        <footer class="editor__foot">
            <span class="pill" title="{{ 'editor.tip.foot.number'|trans }}"><b>{{ 'editor.foot.number'|trans }}</b> <span data-editor-target="number">–</span></span>
            <span class="pill" title="{{ 'editor.tip.foot.name'|trans }}"><b>{{ 'editor.foot.name'|trans }}</b> {{ w.value('preset_name') }}</span>
            <button type="button" class="big" data-action="editor#open" data-editor-dialog-param="store" title="{{ 'editor.tip.panel.store'|trans }}">{{ 'editor.foot.store'|trans }}</button>
            <button type="button" class="big" data-action="editor#open" data-editor-dialog-param="recall" title="{{ 'editor.tip.panel.recall'|trans }}">{{ 'editor.foot.recall'|trans }}</button>
            <span class="editor__error" data-editor-target="error" role="status"></span>
        </footer>

        {{ include('editor/_dialogs.html.twig') }}
    </div>
{% endblock %}
