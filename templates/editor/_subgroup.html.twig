{# Sub Control (key 'sub', the input strip, the Aux and the output strip) or Group Control (key 'groups', 8 strips), in its dialog and on the Gain page.
   heading: an optional panel title that also makes the panel foldable, the dialog has its own head. class: extra classes for the panel. #}
{% import 'editor/_widgets.html.twig' as w %}
{% set heading = heading|default(null) %}
<div class="strips {{ class|default('') }}"{% if heading %} data-controller="collapse" data-collapse-key-value="gain.{{ key }}"{% endif %}>
    {% if heading %}<h2 class="strips__title">{{ w.fold(heading, key) }}</h2>{% endif %}
    {% for k in 0..('sub' == key ? 1 : 7) %}
        {% set p = key ~ '.' ~ k %}
        {% set outputs = 'sub' == key ? 1 == k : k >= 4 %}
        {% if 'sub' == key %}
            {% set send = [{command: 'subControl', args: {io: k, gainPercent: '@' ~ p ~ '.gain', muted: '@' ~ p ~ '.mute', mask: '@' ~ p ~ '.mask', extra: '@sub_extra.' ~ k}}] %}
            {% set title = outputs ? 'Output' : 'Input' %}
        {% else %}
            {% set send = [{command: 'group', args: {index: k, gainPercent: '@' ~ p ~ '.gain', muted: '@' ~ p ~ '.mute', mask: '@' ~ p ~ '.mask'}}] %}
            {% set title = (outputs ? 'Out group %group%' : 'In group %group%')|trans({'%group%': outputs ? k - 3 : k + 1}) %}
        {% endif %}
        {% if 'sub' == key and outputs %}
            {# The Aux between the input and the output strip: its gain and mute, incoming inputs and outgoing outputs #}
            <div class="strip" data-controller="channelvisibility" data-channelvisibility-index-value="18">
                <h3 class="strip__title">{{ w.ch(18) }}</h3>
                <div class="strip__row">
                    {{ w.fader('', 'aux.gain', [{command: 'gain', args: {channel: 18, raw: '@aux.gain'}}], 0, 400, 'gain', null, {label: 'Aux gain', default: 280, muted_by: 'aux.mute'}) }}
                    {{ w.meter(16) }}
                </div>
                {{ w.toggle('Mute', 'aux.mute', [{command: 'mute', args: {channel: 18, on: '@aux.mute'}}], null, {class: 'toggle--mute', muted_by: 'aux.gain'}) }}
                {% include 'editor/_aux_routes.html.twig' %}
            </div>
        {% endif %}
        <div class="strip" data-controller="linkplace selectors" data-linkplace-visible-value="true">
            <h3 class="strip__title">{{ title|trans }}</h3>
            {{ w.fader('', p ~ '.gain', send, 0, 100, 'percent', null, {label: '%channel% gain'|trans({'%channel%': title|trans}), muted_by: p ~ '.mute'}) }}
            {{ w.toggle('Mute', p ~ '.mute', send, null, {class: 'toggle--mute'}) }}
            {% for b in 0..7 %}
                {{ w.toggle(w.ch(outputs ? 8 + b : b), p ~ '.mask', send, null, {bit: b, class: 'toggle--route'}) }}
            {% endfor %}
        </div>
    {% endfor %}
</div>
