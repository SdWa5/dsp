{#
 # Widget macros. Every widget binds to a state path ("inputs.0.gain") and sends commands built from
 # templates in which "@path" arguments are read from the state. link = "inputs:0" also writes to the
 # channels linked with In1. A widget whose state path has a tooltip under editor.tip (see tip()) shows it on hover,
 # options.tip names another key.
 #}

{# The tooltip of a state path: "outputs.3.comp.ratio" looks up editor.tip.comp.ratio, an empty string when there is none #}
{% macro tip(bind, key = null) -%}
    {%- set key = 'editor.tip.' ~ (key ?? bind|split('.')|filter(s => s not in ['inputs', 'outputs', 'aux'] and not (s matches '/^\\d+$/'))|join('.')) -%}
    {%- set text = key|trans -%}
    {#- Raw here, the attribute that prints it escapes it once -#}
    {{- (text != key ? text : '')|raw -}}
{%- endmacro %}

{# options: class, enabled, default, label, tip, muted_by (a mute path, the knob turns red while it is set),
   comp (a compressor path, the knob turns red while that compressor is off) #}
{% macro fader(title, bind, send, min, max, fmt, link = null, options = {}) %}
    {% set tip = _self.tip(bind, options.tip ?? null)|trim %}
    <div{% if tip %} title="{{ tip }}"{% endif %} class="fader{{ options.class is defined ? ' ' ~ options.class }}" data-controller="fader"
         data-fader-bind-value="{{ bind }}" data-fader-send-value="{{ send|json_encode }}"
         data-fader-fmt-value="{{ fmt }}"{% if link %} data-fader-link-value="{{ link }}"{% endif %}
         {% if options.enabled is defined %} data-fader-enabled-value="{{ options.enabled }}"{% endif %}
         {% if options.default is defined %} data-fader-default-value="{{ options.default }}"{% endif %}
         {% if options.muted_by is defined %} data-fader-muted-by-value="{{ options.muted_by }}"{% endif %}
         {% if options.comp is defined %} data-fader-comp-value="{{ options.comp }}"{% endif %}>
        {% if title %}<span class="fader__title">{{ title|trans }}</span>{% endif %}
        <input type="range" min="{{ min }}" max="{{ max }}" step="1" aria-label="{{ options.label|default(title ?: bind)|trans }}"
               title="{{ (tip ? tip ~ ' ') ~ "Double-click: back to the default"|trans }}"
               data-fader-target="input" data-action="input->fader#input wheel->fader#wheel dblclick->fader#reset">
        <input type="text" class="fader__value" inputmode="decimal" aria-label="{{ '%label% value'|trans({'%label%': options.label|default(title ?: bind)|trans}) }}"
               data-fader-target="label" data-action="change->fader#typed keydown->fader#key focus->fader#focus blur->fader#blur">
    </div>
{% endmacro %}

{% macro toggle(label, bind, send, link = null, options = {}) %}
    {% set label = label is same as(label|striptags) ? label|trans : label %}
    {% set tip = _self.tip(bind, options.tip ?? null)|trim %}
    <button type="button"{% if tip %} title="{{ tip }}"{% endif %} class="toggle{{ options.class is defined ? ' ' ~ options.class }}" data-controller="toggle"
            data-action="toggle#click" data-toggle-bind-value="{{ bind }}" data-toggle-send-value="{{ send|json_encode }}"
            {% if link %} data-toggle-link-value="{{ link }}"{% endif %}
            {% if options.bit is defined %} data-toggle-bit-value="{{ options.bit }}"{% endif %}
            {% if options.on is defined %} data-toggle-text-on-value="{{ options.on|trans }}" data-toggle-text-off-value="{{ label }}"{% endif %}
            {% if options.enabled is defined %} data-toggle-enabled-value="{{ options.enabled }}"{% endif %}
            {% if options.muted_by is defined %} data-toggle-muted-by-value="{{ options.muted_by }}"{% endif %}
            {% if options.aria is defined %} aria-label="{{ options.aria|trans }}"{% endif %}>{{ label }}</button>
{% endmacro %}

{% macro choice(label, bind, send, items, link = null, options = {}) %}
    {% set tip = _self.tip(bind, options.tip ?? null)|trim %}
    <select{% if tip %} title="{{ tip }}"{% endif %} class="choice" aria-label="{{ label|trans }}" data-controller="choice" data-action="choice#change"
            data-choice-bind-value="{{ bind }}" data-choice-send-value="{{ send|json_encode }}"
            {% if link %} data-choice-link-value="{{ link }}"{% endif %}
            {% if options.enabled is defined %} data-choice-enabled-value="{{ options.enabled }}"{% endif %}>
        {% for value, text in items %}<option value="{{ value }}">{{ text }}</option>{% endfor %}
    </select>
{% endmacro %}

{% macro text(label, bind, send, maxlength, link = null) %}
    <input type="text" class="text" title="{{ 'editor.tip.name'|trans }}" aria-label="{{ label|trans }}" maxlength="{{ maxlength }}" data-controller="text"
           data-action="change->text#change" data-text-bind-value="{{ bind }}" data-text-send-value="{{ send|json_encode }}"
           {% if link %} data-text-link-value="{{ link }}"{% endif %}>
{% endmacro %}

{% macro value(bind, fmt = 'raw') %}
    <span class="value" data-controller="value" data-value-bind-value="{{ bind }}" data-value-fmt-value="{{ fmt }}">–</span>
{% endmacro %}

{# Level bar of a meter slot: 0..7 In1..In8, 8..15 Out1..Out8 (with the Limit lamp), 16 Aux #}
{% macro meter(index, label = null) %}
    {%- set output = index >= 8 and index < 16 -%}
    <div class="meter{{ output ? ' meter--output' }}" data-controller="meter" data-meter-index-value="{{ index }}" role="meter" aria-label="{{ (label ?? 'Level')|trans }}">
        <span class="meter__bar"></span><span class="meter__peak"></span><span class="meter__threshold" data-meter-target="threshold" hidden></span>
        {%- if output %}<span class="meter__limit"></span>{% endif %}
    </div>
{% endmacro %}

{# The curve of a gate (kind gate, path an input) or compressor (kind comp, path an output or aux), small, in a
   channel's Gate or Comp group or beside the Aux compressor's faders #}
{% macro dynamics(kind, path, options = {}) %}
    <div class="dynamics{{ options.class is defined ? ' ' ~ options.class }}" data-controller="dynamics" data-dynamics-kind-value="{{ kind }}" data-dynamics-path-value="{{ path }}">
        <canvas class="dynamics__plot" data-dynamics-target="canvas" role="img"></canvas>
    </div>
{% endmacro %}

{# The large curve of the Gate and Comp pages, inside the dynamics controller that follows the strips. tip: a key under editor.tip.panel #}
{% macro dynamics_panel(title, kind, tip) %}
    <div class="dynamics-panel" data-controller="collapse" data-collapse-key-value="{{ kind }}.curve">
        <h2 class="strips__title">{{ _self.fold(title, tip) }}</h2>
        <canvas class="dynamics__plot dynamics__plot--page" data-dynamics-target="canvas" role="img"></canvas>
    </div>
{% endmacro %}

{# Channel ID with the channel's name and its link group next to it: 0..7 In1..In8, 8..15 Out1..Out8, 18 Aux.
   options: class, title (omits the name repeated by its edit field), link (false hides the link group, as in the Link dialog, which shows the groups being edited) #}
{% macro ch(index, options = {}) -%}
    {%- set id = index < 8 ? 'In' ~ (index + 1) : (index < 16 ? 'Out' ~ (index - 7) : 'Aux') -%}
    <span class="ch{{ options.class is defined ? ' ' ~ options.class }}" data-controller="channel" data-channel-index-value="{{ index }}"{% if options.link is defined and not options.link %} data-channel-link-value="false"{% endif %}{% if options.title|default(false) %} data-channel-title-value="true"{% endif %}><b class="ch__id">{{ id }}</b>{% if not options.title|default(false) %}<span class="ch__name"></span>{% endif %}</span>
{%- endmacro %}

{# An <option> with the channel ID and name, value defaults to the channel index. #}
{% macro ch_option(index, value = null) -%}
    {%- set id = index < 8 ? 'In' ~ (index + 1) : (index < 16 ? 'Out' ~ (index - 7) : 'Aux') -%}
    <option value="{{ value ?? index }}" data-controller="channel" data-channel-index-value="{{ index }}">{{ id }}</option>
{%- endmacro %}

{# The title of a panel with data-controller="collapse": a button that folds the panel. tip: a key under editor.tip.panel #}
{% macro fold(label, tip = null) -%}
    <button type="button"{% if tip %} title="{{ ('editor.tip.panel.' ~ tip)|trans }}"{% endif %} class="fold" data-collapse-target="toggle" data-action="collapse#toggle" aria-expanded="true">{{ label|trans }}</button>
{%- endmacro %}

{# Shown on the Comp page while output o (0..7) runs at compressor 1:1.0 with a gain other than 0 dB, with the fix #}
{% macro gain_warning(o) -%}
    <div class="gain-warning" data-controller="gainwarning" data-gainwarning-path-value="outputs.{{ o }}" data-gainwarning-channel-value="{{ 8 + o }}" hidden>
        <span title="{{ "At compressor ratio 1:1.0 the 8x8 applies every gain but 0 dB more strongly than set and adds the spectrum mirrored at 24 kHz."|trans }}">{{ "⚠ 1:1.0 exaggerates the gain"|trans }}</span>
        <label class="check" title="{{ "On: the fix only sets 1:1.1 and leaves the threshold, so levels above it get compressed slightly. Off: the threshold goes to +20 dB, where 1:1.1 never compresses."|trans }}"><input type="checkbox" data-gainwarning-target="keepThreshold" data-action="change->gainwarning#keepThresholdChange"> {{ "Keep threshold"|trans }}</label>
        <span title="{{ "1:1.1 with the threshold at +20 dB never compresses and keeps the gain exact."|trans }}" data-gainwarning-target="fixText">{{ "Fix with 1:1.1 at +20 dB:"|trans }}</span>
        <span title="{{ "1:1.1 compresses levels above the threshold slightly, below it the gain is exact."|trans }}" data-gainwarning-target="fixTextKeep" hidden>{{ "Fix with 1:1.1, threshold as set:"|trans }}</span>
        <span class="gain-warning__buttons"><button type="button" class="toggle" data-action="gainwarning#exact" title="{{ "The gain then acts as set, so the output gets louder or quieter by the exaggeration"|trans }}">{{ "Exact gain"|trans }} <span data-gainwarning-target="exact"></span></button>
        <button type="button" class="toggle" data-action="gainwarning#keepLevel" title="{{ "Moves the gain to the level the output had at 1:1.0 (modelled, within 0.5 dB up to +9 dB set; above about +6 dB it stops at +12 dB)"|trans }}">{{ "Keep level"|trans }} <span data-gainwarning-target="keep"></span></button></span>
    </div>
{%- endmacro %}
