{% import 'editor/_widgets.html.twig' as w %}
<div class="toolbar">
    <label>{{ "Unit"|trans }} {{ w.choice('Delay unit', 'delay_unit', [{command: 'delayUnit', args: {unit: '@delay_unit'}}], labels.DELAY_UNITS) }}</label>
    <span class="page__note">{{ "Type a value into a field in the chosen unit, or add ms, m or ft."|trans }}</span>
</div>
<div class="strips">
    {% for i in 0..7 %}
        {% set p = 'outputs.' ~ i %}
        <div class="strip">
            <h3 class="strip__title">{{ w.ch(8 + i) }}</h3>
            {{ w.fader('', p ~ '.delay', [{command: 'delay', args: {channel: 8 + i, samples: '@' ~ p ~ '.delay'}}], 0, 32640, 'delay', null, {class: 'fader--tall', label: '%channel% delay'|trans({'%channel%': 'Out' ~ (i + 1)}), default: 0}) }}
        </div>
    {% endfor %}
</div>
