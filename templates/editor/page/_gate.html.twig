{% import 'editor/_widgets.html.twig' as w %}
<div class="strips">
    {% for i in 0..7 %}
        {% set p = 'inputs.' ~ i %}
        {% set send = [{command: 'gate', args: {channel: i, attack: '@' ~ p ~ '.gate.attack', release: '@' ~ p ~ '.gate.release', threshold: '@' ~ p ~ '.gate.threshold'}}] %}
        <div class="strip">
            <h3 class="strip__title">{{ w.value(p ~ '.name') }}</h3>
            <div class="strip__row">
                {{ w.fader('Threshold', p ~ '.gate.threshold', send, 0, 180, 'threshold') }}
                <div class="strip__stack">
                    {{ w.fader('Attack', p ~ '.gate.attack', send, 0, 998, 'ms', null, {class: 'fader--short'}) }}
                    {{ w.fader('Release', p ~ '.gate.release', send, 0, 2999, 'ms', null, {class: 'fader--short'}) }}
                </div>
                {{ w.meter(i) }}
            </div>
        </div>
    {% endfor %}
</div>
