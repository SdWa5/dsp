{% import 'editor/_widgets.html.twig' as w %}
<h2 class="page__title">{{ w.ch(18, {class: 'ch--big'}) }} {{ w.text('Aux name', 'aux.name', [{command: 'channelName', args: {channel: 18, name: '@aux.name'}}], 8) }}</h2>
{% embed 'editor/_peq.html.twig' with {p: 'aux', channel: 18, filters: false, bands: 5} %}
    {% block side %}
        {% import 'editor/_widgets.html.twig' as w %}
        {% set comp = [{command: 'compressor', args: {channel: 18, ratio: '@aux.comp.ratio', knee: '@aux.comp.knee', attack: '@aux.comp.attack', release: '@aux.comp.release', threshold: '@aux.comp.threshold'}}] %}
        <fieldset class="group group--dynamics" data-controller="collapse" data-collapse-key-value="aux.comp">
            <legend>{{ w.fold('Comp', 'aux_comp') }}</legend>
            {# The threshold and Set button share the left column; the curve uses the channel dynamics layout. #}
            <div class="group-stack">
                {{ w.fader(null, 'aux.comp.threshold', comp, 0, 220, 'threshold', null, {label: 'Aux compressor threshold', comp: 'aux.comp'}) }}
                <button type="button" class="toggle" data-action="editor#open" data-editor-dialog-param="auxcomp">{{ "Set"|trans }}</button>
            </div>
            {{ w.dynamics('comp', 'aux') }}
        </fieldset>
        <div class="group-stack">
            {% for key, spec in {automix: ['AutoMix', 18], effect: ['Effect', null], camera: ['Camera', 19]} %}
                <fieldset class="group" data-controller="collapse" data-collapse-key-value="aux.{{ key }}">
                    <legend>{{ w.fold(spec[0], key) }}</legend>
                    {% if spec[1] is null %}
                        {% set send = [{command: 'effect', args: {on: '@aux.effect.on', gain: '@aux.effect.gain'}}] %}
                    {% else %}
                        {% set m = 'aux.' ~ key %}
                        {% set send = [{command: 'mixFunction', args: {channel: spec[1], attack: '@' ~ m ~ '.attack', release: '@' ~ m ~ '.release', threshold: '@' ~ m ~ '.threshold', select: '@' ~ m ~ '.select', on: '@' ~ m ~ '.on'}}] %}
                    {% endif %}
                    {{ w.toggle('Off', 'aux.' ~ key ~ '.on', send, null, {on: 'On', class: 'toggle--on'}) }}
                    <button type="button" class="toggle" data-action="editor#open" data-editor-dialog-param="{{ key }}">{{ "Set"|trans }}</button>
                </fieldset>
            {% endfor %}
        </div>
        <fieldset class="group" data-controller="collapse" data-collapse-key-value="aux.select">
            <legend>{{ w.fold('Select', 'aux_select') }}</legend>
            {% include 'editor/_aux_routes.html.twig' %}
        </fieldset>
        <fieldset class="group" data-controller="collapse" data-collapse-key-value="aux.gain">
            <legend>{{ w.fold('Gain', 'aux_gain') }}</legend>
            <div class="strip__row">
                {{ w.fader(null, 'aux.gain', [{command: 'gain', args: {channel: 18, raw: '@aux.gain'}}], 0, 400, 'gain', null, {label: 'Aux gain', default: 280, muted_by: 'aux.mute'}) }}
                {{ w.meter(16) }}
            </div>
            {{ w.toggle('Mute', 'aux.mute', [{command: 'mute', args: {channel: 18, on: '@aux.mute'}}], null, {class: 'toggle--mute', muted_by: 'aux.gain'}) }}
        </fieldset>
    {% endblock %}
{% endembed %}
