{% import 'editor/_widgets.html.twig' as w %}
{% set input = 'inputs' == side %}
{% set channel = input ? i : 8 + i %}
{% set p = side ~ '.' ~ i %}
{% set link = side ~ ':' ~ i %}
{# Group titles are editable once; every linked member keeps its own device-name binding and ID. #}
<div class="channel-page-heading" data-controller="linkname" data-linkname-index-value="{{ channel }}">
    <h2 class="page__title" data-linkname-target="heading">
        <span data-linkname-target="plainTitle">{{ w.ch(channel, {class: 'ch--big', title: true, link: false}) }}</span>
        <span class="channel-link-name" data-linkname-target="groupTitle" hidden>
            <span data-linkname-target="fields"></span><span data-linkname-target="empty" hidden></span>
        </span>
    </h2>
    <div class="channel-member-names">
        {% for member in 0..7 %}
            {% set memberId = (input ? 'In' : 'Out') ~ (member + 1) %}
            {% set memberPath = side ~ '.' ~ member ~ '.name' %}
            <label class="channel-name-edit" data-linkname-target="member" data-name-index="{{ member + (input ? 0 : 8) }}" title="{{ 'editor.tip.name'|trans }}"{{ member != i ? ' hidden' }}>
                <span class="channel-name-id">{{ memberId }}</span>
                {{ w.text('%channel% name'|trans({'%channel%': memberId}), memberPath, [{command: 'channelName', args: {channel: member + (input ? 0 : 8), name: '@' ~ memberPath}}], 8) }}
            </label>
        {% endfor %}
    </div>
</div>
{% embed 'editor/_peq.html.twig' with {p: p, channel: channel, filters: true, bands: input ? 5 : 7} %}
    {% block common %}
        {% import 'editor/_widgets.html.twig' as w %}
        <fieldset class="group" data-controller="collapse" data-collapse-key-value="channel.gain">
            <legend>{{ w.fold('Gain', 'gain') }}</legend>
            <div class="strip__row">
                {{ w.fader(null, p ~ '.gain', [{command: 'gain', args: {channel: channel, raw: '@' ~ p ~ '.gain'}}], 0, 400, 'gain', link, {label: 'Gain', default: 280, muted_by: p ~ '.mute'}) }}
                {{ w.meter(channel) }}
            </div>
            {{ w.toggle('Normal', p ~ '.phase', [{command: 'phase', args: {channel: channel, inverted: '@' ~ p ~ '.phase'}}], link, {on: 'Inverse'}) }}
            {{ w.toggle('Mute', p ~ '.mute', [{command: 'mute', args: {channel: channel, on: '@' ~ p ~ '.mute'}}], link, {class: 'toggle--mute', muted_by: p ~ '.gain'}) }}
            {% if input %}
                {{ w.choice('Mode', p ~ '.mode', [{command: 'inputMode', args: {channel: channel, mode: '@' ~ p ~ '.mode'}}], labels.INPUT_MODES, link) }}
                {{ w.toggle('+48V', p ~ '.phantom', [{command: 'phantom', args: {channel: channel, on: '@' ~ p ~ '.phantom'}}], link, {class: 'toggle--phantom', enabled: p ~ '.mode'}) }}
            {% endif %}
        </fieldset>
    {% endblock %}
    {% block side %}
        {% import 'editor/_widgets.html.twig' as w %}
        {# The same controls as on the Gate, Comp and Delay pages, without a second meter #}
        {% if input %}
            <fieldset class="group group--dynamics" data-controller="collapse" data-collapse-key-value="channel.gate">
                <legend>{{ w.fold('editor.tabs.gate', 'gate') }}</legend>
                {{ include('editor/page/_gate_controls.html.twig', {i: i}) }}
                {{ w.dynamics('gate', p) }}
            </fieldset>
        {% else %}
            <fieldset class="group group--dynamics" data-controller="collapse" data-collapse-key-value="channel.comp">
                <legend>{{ w.fold('editor.tabs.comp', 'comp') }}</legend>
                {{ include('editor/page/_compressor.html.twig', {p: p, channel: channel, meter: null, link: link}) }}
                {{ w.dynamics('comp', p) }}
                {{ w.gain_warning(i) }}
            </fieldset>
            <fieldset class="group" data-controller="collapse" data-collapse-key-value="channel.delay">
                <legend>{{ w.fold('editor.tabs.delay', 'delay') }}</legend>
                {{ w.fader('', p ~ '.delay', [{command: 'delay', args: {channel: channel, samples: '@' ~ p ~ '.delay'}}], 0, 32640, 'delay', link, {label: '%channel% delay'|trans({'%channel%': 'Out' ~ (i + 1)}), default: 0}) }}
                <label class="group__caption">{{ "Unit"|trans }} {{ w.choice('Delay unit', 'delay_unit', [{command: 'delayUnit', args: {unit: '@delay_unit'}}], labels.DELAY_UNITS) }}</label>
            </fieldset>
        {% endif %}
        {% if input %}
            <fieldset class="group" data-controller="collapse" data-collapse-key-value="channel.fbq">
                <legend>{{ w.fold('FBQ', 'fbq') }}</legend>
                <div class="radios" data-controller="choice" data-action="change->choice#change" data-choice-bind-value="{{ p }}.fbq" data-choice-link-value="{{ link }}"
                     data-choice-send-value="{{ [{command: 'fbq', args: {channel: channel, level: '@' ~ p ~ '.fbq'}}]|json_encode }}">
                    {% for value, text in labels.FBQ_LEVELS %}
                        <label class="radio"><input type="radio" name="fbq-{{ i }}" value="{{ value }}"><span>{{ text }}</span></label>
                    {% endfor %}
                </div>
            </fieldset>
        {% endif %}
    {% endblock %}
{% endembed %}
