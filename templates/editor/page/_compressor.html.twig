{% import 'editor/_widgets.html.twig' as w %}
{% set c = p ~ '.comp' %}
{% set link = link ?? null %}
{# The knee byte goes back as the device holds it. The vendor editor has no control for it, see docs/protocol.md #}
{% set send = [{command: 'compressor', args: {channel: channel, ratio: '@' ~ c ~ '.ratio', knee: '@' ~ c ~ '.knee', attack: '@' ~ c ~ '.attack', release: '@' ~ c ~ '.release', threshold: '@' ~ c ~ '.threshold'}}] %}
<div class="strip__row">
    {{ w.fader('Threshold', c ~ '.threshold', send, 0, 220, 'threshold', link) }}
    {{ w.fader('Ratio', c ~ '.ratio', send, 0, 15, 'ratio', link) }}
    <div class="strip__stack">
        {{ w.fader('Attack', c ~ '.attack', send, 0, 998, 'ms', link, {class: 'fader--short'}) }}
        {{ w.fader('Release', c ~ '.release', send, 9, 2999, 'ms', link, {class: 'fader--short'}) }}
    </div>
    {% if meter is not null %}{{ w.meter(meter) }}{% endif %}
</div>
