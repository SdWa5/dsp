{% import 'editor/_widgets.html.twig' as w %}
{% set c = p ~ '.comp' %}
{% set link = link ?? null %}
{# The vendor's Aux Compressor Setting dialog stops at 200 ms attack and 999 ms release, its output compressors at 999 ms and 3000 ms (tools/shots/ranges/aux_comp_max.png, comp.png) #}
{% set attack_max = attack_max ?? 998 %}
{% set release_max = release_max ?? 2999 %}
{# The knee byte goes back as the device holds it. The vendor editor has no control for it, see docs/protocol.md #}
{% set send = [{command: 'compressor', args: {channel: channel, ratio: '@' ~ c ~ '.ratio', knee: '@' ~ c ~ '.knee', attack: '@' ~ c ~ '.attack', release: '@' ~ c ~ '.release', threshold: '@' ~ c ~ '.threshold'}}] %}
<div class="strip__row">
    {{ w.fader('Threshold', c ~ '.threshold', send, 0, 220, 'threshold', link, {comp: c}) }}
    {{ w.fader('Ratio', c ~ '.ratio', send, 0, 15, 'ratio', link, {comp: c}) }}
    <div class="strip__stack">
        {{ w.fader('Attack', c ~ '.attack', send, 0, attack_max, 'ms', link, {class: 'fader--short', comp: c}) }}
        {{ w.fader('Release', c ~ '.release', send, 0, release_max, 'ms', link, {class: 'fader--short', comp: c}) }}
    </div>
    {% if meter is not null %}{{ w.meter(meter) }}{% endif %}
</div>
