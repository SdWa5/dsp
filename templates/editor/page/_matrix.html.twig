{% import 'editor/_widgets.html.twig' as w %}
<div class="matrix-wrap">
    <table class="matrix">
        <caption>Which inputs feed each output</caption>
        <thead>
            <tr>
                <th scope="col"><span class="matrix__corner">Out ＼ In</span></th>
                {% for i in 0..8 %}<th scope="col">{{ w.ch(i < 8 ? i : 18) }}</th>{% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for o in 0..7 %}
                {% set p = 'outputs.' ~ o %}
                {% set send = [{command: 'routing', args: {channel: 8 + o, mask: '@' ~ p ~ '.route'}}] %}
                <tr>
                    <th scope="row">{{ w.ch(8 + o) }}</th>
                    {% for i in 0..8 %}
                        <td>{{ w.toggle('', p ~ '.route', send, null, {bit: i, class: 'toggle--cell', aria: 'Out' ~ (o + 1) ~ ' from ' ~ (i < 8 ? 'In' ~ (i + 1) : 'Aux')}) }}</td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
