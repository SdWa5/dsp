{% import 'editor/_widgets.html.twig' as w %}
{#
 # Outputs as rows (the vendor editor's layout) or, swapped, inputs as rows. Both tables are rendered and the
 # corner button shows one of them. Every cell carries its own binding, so the two stay in step through the store.
 #}
{% macro cell(o, i) %}
    {% import 'editor/_widgets.html.twig' as w %}
    {% set p = 'outputs.' ~ o %}
    <td data-source="{{ i }}" data-output="{{ o }}">{{ w.toggle('', p ~ '.route', [{command: 'routing', args: {channel: 8 + o, mask: '@' ~ p ~ '.route'}}], null, {bit: i, class: 'toggle--cell', aria: '%output% from %input%'|trans({'%output%': 'Out' ~ (o + 1), '%input%': i < 8 ? 'In' ~ (i + 1) : 'Aux'})}) }}</td>
{% endmacro %}
{# Hovering a cell, a header or a part of the graph brings out the same routing in both #}
<div class="matrix-page" data-controller="routefocus" data-action="pointerover->routefocus#over pointerleave->routefocus#leave routing:rendered->routefocus#reapply">
<div class="matrix-wrap fold-panel" data-controller="collapse" data-collapse-key-value="matrix.matrix">
    <h3 class="fold-panel__title">{{ w.fold('Matrix', 'matrix') }}</h3>
    {# The signal runs from In to Out: the In headers sit on the left or at the top, the Out headers on the right or at the bottom #}
    {% for swapped in [false, true] %}
        {% set corner %}
            <th scope="col">
                <button type="button" class="matrix__corner" data-action="editor#swapMatrix"
                        title="{{ "Swap rows and columns"|trans }}">In → Out ⇄</button>
            </th>
        {% endset %}
        <table class="matrix" data-controller="linkplace" data-editor-target="matrix" data-swapped="{{ swapped ? 1 : 0 }}"{{ swapped ? ' hidden' }}>
            <caption>{{ (swapped ? 'Which outputs each input feeds' : 'Which inputs feed each output')|trans }}</caption>
            {% if swapped %}
                <tbody>
                    {% for i in 0..8 %}
                        <tr>
                            <th scope="row" data-source="{{ i }}">{{ w.ch(i < 8 ? i : 18) }}</th>
                            {% for o in 0..7 %}{{ _self.cell(o, i) }}{% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        {{ corner }}
                        {% for o in 0..7 %}<th scope="col" data-output="{{ o }}">{{ w.ch(8 + o) }}</th>{% endfor %}
                    </tr>
                </tfoot>
            {% else %}
                <thead>
                    <tr>
                        {% for i in 0..8 %}<th scope="col" data-source="{{ i }}">{{ w.ch(i < 8 ? i : 18) }}</th>{% endfor %}
                        {{ corner }}
                    </tr>
                </thead>
                <tbody>
                    {% for o in 0..7 %}
                        <tr>
                            {% for i in 0..8 %}{{ _self.cell(o, i) }}{% endfor %}
                            <th scope="row" class="matrix__end" data-output="{{ o }}">{{ w.ch(8 + o) }}</th>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endif %}
        </table>
    {% endfor %}
</div>
<div class="routing fold-panel" data-controller="collapse routing" data-collapse-key-value="matrix.graph">
    <h3 class="fold-panel__title">{{ w.fold('Routing graph', 'routing_graph') }}</h3>
    <svg class="routing__graph" data-routing-target="svg" role="img" aria-label="{{ 'Routing graph'|trans }}"></svg>
</div>
</div>
