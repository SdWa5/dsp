{% import 'editor/_widgets.html.twig' as w %}
{#
 # Outputs as rows or, swapped, inputs as rows. Aux is last on both axes. Both tables are rendered and the
 # corner button shows one. Each supported cell binds to its destination mask, so the tables stay in step.
 #}
{% macro cell(o, i) %}
    {% import 'editor/_widgets.html.twig' as w %}
    {% if o == 8 and i == 8 %}
        <td><button type="button" class="matrix__unsupported" disabled title="{{ 'Aux cannot feed itself'|trans }}" aria-label="{{ 'Aux cannot feed itself'|trans }}">×</button></td>
    {% else %}
        {% set p = o == 8 ? 'aux.select' : 'outputs.' ~ o ~ '.route' %}
        {% set output = o == 8 ? 'Aux' : 'Out' ~ (o + 1) %}
        {% set input = i == 8 ? 'Aux' : 'In' ~ (i + 1) %}
        <td data-source="{{ i }}" data-output="{{ o }}">{{ w.toggle('', p, [{command: 'routing', args: {channel: o == 8 ? 18 : 8 + o, mask: '@' ~ p}}], null, {bit: i, class: 'toggle--cell', aria: '%output% from %input%'|trans({'%output%': output, '%input%': input})}) }}</td>
    {% endif %}
{% endmacro %}
{# Hovering a cell, a header or a part of the graph brings out the same routing in both #}
<div class="matrix-page" data-controller="routefocus" data-action="pointerover->routefocus#over pointerleave->routefocus#leave routing:rendered->routefocus#reapply routing:editing->routefocus#leave">
<div class="matrix-wrap fold-panel" data-controller="collapse" data-collapse-key-value="matrix.matrix">
    <h3 class="fold-panel__title">{{ w.fold('Matrix', 'matrix') }}</h3>
    {# The signal runs from In to Out: the In headers sit on the left or at the top, the Out headers on the right or at the bottom #}
    {% for swapped in [false, true] %}
        {% set corner %}
            <th scope="col">
                <button type="button" class="matrix__corner" data-action="editor#swapMatrix"
                        title="{{ "Swap rows and columns"|trans }}">In → Out ⇄</button>
            </th>
        {% endset %}
        <table class="matrix" data-controller="linkplace" data-editor-target="matrix" data-swapped="{{ swapped ? 1 : 0 }}"{{ swapped ? ' hidden' }}>
            <caption>{{ (swapped ? 'Which destinations each source feeds' : 'Which sources feed each destination')|trans }}</caption>
            {% if swapped %}
                <tbody>
                    {% for i in 0..8 %}
                        <tr>
                            <th scope="row" data-source="{{ i }}">{{ w.ch(i < 8 ? i : 18) }}</th>
                            {% for o in 0..8 %}{{ _self.cell(o, i) }}{% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        {{ corner }}
                        {% for o in 0..8 %}<th scope="col" data-output="{{ o }}">{{ w.ch(o == 8 ? 18 : 8 + o) }}</th>{% endfor %}
                    </tr>
                </tfoot>
            {% else %}
                <thead>
                    <tr>
                        {% for i in 0..8 %}<th scope="col" data-source="{{ i }}">{{ w.ch(i < 8 ? i : 18) }}</th>{% endfor %}
                        {{ corner }}
                    </tr>
                </thead>
                <tbody>
                    {% for o in 0..8 %}
                        <tr>
                            {% for i in 0..8 %}{{ _self.cell(o, i) }}{% endfor %}
                            <th scope="row" class="matrix__end" data-output="{{ o }}">{{ w.ch(o == 8 ? 18 : 8 + o) }}</th>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endif %}
        </table>
    {% endfor %}
</div>
<div class="routing fold-panel" data-controller="collapse routing" data-collapse-key-value="matrix.graph" data-action="dblclick->routing#remove keydown->routing#removeKey">
    <h3 class="fold-panel__title">{{ w.fold('Routing graph', 'routing_graph') }}</h3>
    <p id="routing-help" class="routing__help">{{ 'Drag between compatible channels to toggle a route. Enter or Space selects an endpoint; Escape cancels.'|trans }}</p>
    <p class="routing__help">{{ 'Double-click a connection to remove it.'|trans }}</p>
    <svg class="routing__graph" data-routing-target="svg" role="group" aria-label="{{ 'Routing graph'|trans }}" aria-describedby="routing-help"></svg>
    <p class="routing__announcement" data-routing-target="announcement" role="status" aria-live="polite" aria-atomic="true"></p>
</div>
</div>
