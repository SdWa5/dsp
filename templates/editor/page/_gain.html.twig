{% import 'editor/_widgets.html.twig' as w %}
<div class="strips eq-overview" data-controller="collapse eqoverview" data-collapse-key-value="gain.eq">
    <h2 class="strips__title">{{ w.fold('EQ overview', 'eq_overview') }}</h2>
    {# Layout and magnitude/phase share browser preferences with Display Settings. #}
    <div class="peq__bar">
        <label title="{{ 'editor.tip.eq_mag'|trans }}"><input type="checkbox" checked data-eqoverview-target="mag" data-action="eqoverview#toggleView"> {{ "Mag"|trans }}</label>
        <label title="{{ 'editor.tip.eq_phase'|trans }}"><input type="checkbox" data-eqoverview-target="phase" data-action="eqoverview#toggleView"> {{ "Phase"|trans }}</label>
        <label title="{{ 'editor.tip.eq_separate'|trans }}"><input type="checkbox" data-eqoverview-target="separated" data-action="change->eqoverview#separate"> {{ 'Separate plots'|trans }}</label>
    </div>
    <div class="eq-overview__plots" data-eqoverview-target="plots">
        {% for side, title in {combined: 'EQ overview', inputs: 'Input', outputs: 'Output', aux: 'Aux'} %}
            <figure class="eq-overview__pane" data-overview-side="{{ side }}"{% if side != 'combined' %} hidden{% endif %}>
                <figcaption{% if side == 'combined' %} hidden{% endif %}>{{ title|trans }}</figcaption>
                <canvas class="eq-overview__plot" aria-label="{{ title|trans }}" data-eqoverview-target="canvas" data-overview-side="{{ side }}" data-action="pointermove->eqoverview#hoverPlot pointerleave->eqoverview#unhover"></canvas>
                <p class="eq-overview__empty" hidden>{{ 'No visible curves selected.'|trans }}</p>
            </figure>
        {% endfor %}
    </div>
    <div class="eq-overview__switches" data-action="pointerover->eqoverview#hoverSwitch pointerleave->eqoverview#unhover" role="group" aria-label="{{ "Curves shown"|trans }}">
        {% for side in ['inputs', 'outputs'] %}
            <span class="eq-overview__side" data-controller="linkplace" data-linkplace-display-value="true">
                {% for i in 0..7 %}
                    <label class="eq-overview__switch eq-overview__switch--{{ side }}"><input type="checkbox" value="{{ side }}.{{ i }}" checked
                        data-eqoverview-target="show" data-action="change->eqoverview#toggle">{{ w.ch(('outputs' == side ? 8 : 0) + i) }}</label>
                {% endfor %}
            </span>
        {% endfor %}
        <label class="eq-overview__switch eq-overview__switch--aux" data-controller="channelvisibility" data-channelvisibility-index-value="18"><input type="checkbox" value="aux" checked
            data-eqoverview-target="show" data-action="change->eqoverview#toggle">{{ w.ch(18) }}</label>
    </div>
    <p class="eq-overview__note">{{ "Solid: inputs, dashed: outputs, dotted: the Aux. Linked channels share a colour. Point at a curve or a switch to pick it out. A switch only shows or hides a curve, the EQ of the channel stays as it is."|trans }}</p>
</div>
<div class="gain-layout">
<div class="gain-layout__channels">
<div data-controller="riders" data-riders-defaults-value="{{ rider_defaults|json_encode }}">
    <div class="strips" data-controller="collapse linkplace" data-linkplace-display-value="true" data-collapse-key-value="gain.input">
        <h2 class="strips__title">{{ w.fold('Input', 'inputs') }}</h2>
        {% for i in 0..7 %}
            {% set p = 'inputs.' ~ i %}
            <div class="strip">
                <h3 class="strip__title">{{ w.ch(i) }}</h3>
                <div class="strip__row">
                    {{ w.fader('', p ~ '.gain', [{command: 'gain', args: {channel: i, raw: '@' ~ p ~ '.gain'}}], 0, 400, 'gain', 'inputs:' ~ i, {label: '%channel% gain'|trans({'%channel%': 'In' ~ (i + 1)}), default: 280, muted_by: p ~ '.mute'}) }}
                    {{ w.meter(i) }}
                </div>
                <button type="button" class="toggle toggle--rider" data-riders-target="button" data-channel="{{ i }}"
                        data-action="riders#open" data-riders-channel-param="{{ i }}" title="{{ "Gain rider: keeps the input at a target level"|trans }}">{{ "Rider"|trans }}</button>
                <span class="rider-info" data-riders-target="info" data-channel="{{ i }}"></span>
                {{ w.toggle('Normal', p ~ '.phase', [{command: 'phase', args: {channel: i, inverted: '@' ~ p ~ '.phase'}}], 'inputs:' ~ i, {on: 'Inverse'}) }}
                {{ w.choice('Mode', p ~ '.mode', [{command: 'inputMode', args: {channel: i, mode: '@' ~ p ~ '.mode'}}], labels.INPUT_MODES, 'inputs:' ~ i) }}
                {{ w.toggle('Mute', p ~ '.mute', [{command: 'mute', args: {channel: i, on: '@' ~ p ~ '.mute'}}], 'inputs:' ~ i, {class: 'toggle--mute', muted_by: p ~ '.gain'}) }}
                {{ w.toggle('+48V', p ~ '.phantom', [{command: 'phantom', args: {channel: i, on: '@' ~ p ~ '.phantom'}}], 'inputs:' ~ i, {class: 'toggle--phantom', enabled: p ~ '.mode'}) }}
            </div>
        {% endfor %}
    </div>

    <dialog class="dialog" data-riders-target="dialog">
        <header class="dialog__head"><h2 title="{{ 'editor.tip.panel.rider'|trans }}" data-riders-target="title">{{ "Gain rider"|trans }}</h2><button type="button" class="dialog__close" data-action="riders#close" aria-label="{{ "Close"|trans }}">×</button></header>
        <form class="dialog__form" data-riders-target="form" data-action="riders#save">
            <p class="dialog__note">{{ "The rider moves the input gain slowly towards a target meter level. It runs in the bridge, so it keeps working without this page and after a restart. When somebody moves the gain, it pauses for the hold time."|trans }}</p>
            <div class="form-grid">
                {% for key, spec in {target: ['Target level', 'dB', -60, 0, 0.5], min: ['Lowest gain', 'dB', -59.5, 12, 0.5], max: ['Highest gain', 'dB', -59.5, 12, 0.5],
                    slew: ['Fastest change', 'dB/s', 0.1, 10, 0.1], average: ['Averaging time', 's', 0.1, 60, 0.1], silence: ['Hold below', 'dB', -90, 0, 1],
                    deadband: ['Leave alone within', 'dB', 0, 6, 0.1], hold: ['Pause after a manual change', 's', 0, 600, 1]} %}
                    <label>{{ spec[0]|trans }} <span class="unit-input"><input type="number" name="{{ key }}" min="{{ spec[2] }}" max="{{ spec[3] }}" step="{{ spec[4] }}" required>{{ spec[1] }}</span></label>
                {% endfor %}
                <label class="check"><input type="checkbox" name="boost" data-action="change->riders#boost"> {{ "Allow a highest gain above 0 dB"|trans }}</label>
            </div>
            <p class="dialog__note">{{ "Levels are meter levels in dB, on the scale of the compressor threshold. Hold below compares the level before the gain, so a quiet source after a loud one still gets raised."|trans }}</p>
            <p class="dialog__error" data-riders-target="error" role="alert"></p>
            <div class="dialog__buttons">
                <button type="button" class="big big--danger" data-riders-target="stop" data-action="riders#stop">{{ "Stop rider"|trans }}</button>
                <button type="submit" class="big" data-riders-target="submit">{{ "Start rider"|trans }}</button>
            </div>
        </form>
    </dialog>
</div>
<div class="strips" data-controller="collapse linkplace" data-linkplace-display-value="true" data-collapse-key-value="gain.output">
    <h2 class="strips__title">{{ w.fold('Output', 'outputs') }}</h2>
    {% for i in 0..7 %}
        {% set p = 'outputs.' ~ i %}
        <div class="strip">
            <h3 class="strip__title">{{ w.ch(8 + i) }}</h3>
            <div class="strip__row">
                {{ w.fader('', p ~ '.gain', [{command: 'gain', args: {channel: 8 + i, raw: '@' ~ p ~ '.gain'}}], 0, 400, 'gain', 'outputs:' ~ i, {label: '%channel% gain'|trans({'%channel%': 'Out' ~ (i + 1)}), default: 280, muted_by: p ~ '.mute'}) }}
                {{ w.meter(8 + i) }}
            </div>
            {{ w.toggle('Normal', p ~ '.phase', [{command: 'phase', args: {channel: 8 + i, inverted: '@' ~ p ~ '.phase'}}], 'outputs:' ~ i, {on: 'Inverse'}) }}
            {{ w.toggle('Mute', p ~ '.mute', [{command: 'mute', args: {channel: 8 + i, on: '@' ~ p ~ '.mute'}}], 'outputs:' ~ i, {class: 'toggle--mute', muted_by: p ~ '.gain'}) }}
        </div>
    {% endfor %}
</div>
</div>
{{ include('editor/_subgroup.html.twig', {key: 'sub', heading: 'Sub Control', class: 'strips--side'}) }}
</div>
{{ include('editor/_subgroup.html.twig', {key: 'groups', heading: 'Group Control'}) }}
