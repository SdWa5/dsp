{% import 'editor/_widgets.html.twig' as w %}
<div class="strips" data-controller="linkplace">
    {% for i in 0..7 %}
        <div class="strip">
            <h3 class="strip__title">{{ w.ch(8 + i) }}</h3>
            {{ include('editor/page/_compressor.html.twig', {p: 'outputs.' ~ i, channel: 8 + i, meter: 8 + i, link: 'outputs:' ~ i}) }}
            {{ w.gain_warning(i) }}
        </div>
    {% endfor %}
    {# The Aux is in no link group, so the placement leaves it last #}
    <div class="strip">
        <h3 class="strip__title">{{ w.ch(18) }}</h3>
        {{ include('editor/page/_compressor.html.twig', {p: 'aux', channel: 18, meter: 16}) }}
    </div>
</div>
