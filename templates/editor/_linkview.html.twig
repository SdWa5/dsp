{# The link display settings, on Display Settings and below the Link matrices. Both copies stay in step through
   the editor controller. name: the radio group, unique per copy. heading, check: the classes of a heading and a choice. #}
<span class="{{ heading }}">{{ 'editor.link_view.title'|trans }}</span>
{% for key in ['code', 'shape', 'colour'] %}
    <label class="{{ check }}" title="{{ ('editor.tip.display.link_' ~ key)|trans }}"><input title="{{ ('editor.tip.display.link_' ~ key)|trans }}" type="checkbox" value="{{ key }}" data-editor-target="linkView" data-action="change->editor#linkView"> {{ ('editor.link_view.' ~ key)|trans }}</label>
{% endfor %}
<span class="{{ heading }}">{{ 'editor.link_view.placement'|trans }}</span>
{% for key in ['normal', 'side', 'stacked'] %}
    <label class="{{ check }}" title="{{ ('editor.tip.display.placement_' ~ key)|trans }}"><input title="{{ ('editor.tip.display.placement_' ~ key)|trans }}" type="radio" name="{{ name }}" value="{{ key }}" data-editor-target="linkPlacement" data-action="change->editor#linkPlacement"> {{ ('editor.link_view.' ~ key)|trans }}</label>
{% endfor %}
{# One control per link group takes the place of the placement on tabs, strips and EQ switches, so say where it still applies #}
<span class="link-view__scope" hidden data-editor-target="placementScope" title="{{ 'editor.tip.display.placement_scope'|trans }}">{{ 'editor.link_view.placement_scope'|trans }}</span>
