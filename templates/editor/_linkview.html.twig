{# The link display settings, in the Channels menu and below the Link matrices. Both copies stay in step through
   the editor controller. name: the radio group, unique per copy. heading, check: the classes of a heading and a choice. #}
<span class="{{ heading }}">{{ 'editor.link_view.title'|trans }}</span>
{% for key in ['code', 'shape', 'colour'] %}
    <label class="{{ check }}"><input type="checkbox" value="{{ key }}" data-editor-target="linkView" data-action="change->editor#linkView"> {{ ('editor.link_view.' ~ key)|trans }}</label>
{% endfor %}
<span class="{{ heading }}">{{ 'editor.link_view.placement'|trans }}</span>
{% for key in ['normal', 'side', 'stacked'] %}
    <label class="{{ check }}"><input type="radio" name="{{ name }}" value="{{ key }}" data-editor-target="linkPlacement" data-action="change->editor#linkPlacement"> {{ ('editor.link_view.' ~ key)|trans }}</label>
{% endfor %}
