{% import 'editor/_widgets.html.twig' as w %}
{% macro dialog(id, title) %}
    <header class="dialog__head"><h2>{{ title }}</h2><button type="button" class="dialog__close" data-action="editor#close" aria-label="Close">×</button></header>
{% endmacro %}

<dialog class="dialog" id="dialog-connect" data-editor-target="dialog">
    {{ _self.dialog('connect', 'Connection') }}
    <p class="dialog__status" data-editor-target="status">–</p>
    <form class="dialog__form" data-action="editor#connectTo">
        <label>Target <input type="text" name="target" data-editor-target="target" placeholder="auto, 192.168.68.10, usb or demo" required></label>
        <div class="dialog__buttons">
            <button type="button" class="big" data-action="editor#scan" data-editor-target="scanButton">Scan</button>
            <button type="submit" class="big">Connect</button>
            <button type="button" class="big" data-action="editor#disconnectDevice">Disconnect</button>
        </div>
    </form>
    <p class="dialog__note" data-editor-target="scanStatus" hidden></p>
    <ul class="found" data-editor-target="found"></ul>
    <p class="dialog__note">"auto" connects to the first device found, USB before the network. Disconnect frees the device's
        connection, and the vendor editor may take it at once.</p>
</dialog>

<dialog class="dialog" id="dialog-store" data-editor-target="dialog">
    {{ _self.dialog('store', 'Store preset') }}
    <form class="dialog__form" data-action="editor#store">
        <label>Slot <select name="number" data-editor-target="slots" data-first="1"></select></label>
        <label>Name <input type="text" name="name" maxlength="14" required data-editor-target="storeName"></label>
        <p class="dialog__note">The live settings replace the slot. Every store is confirmed first.</p>
        <div class="dialog__buttons"><button type="submit" class="big">Store</button></div>
    </form>
</dialog>

<dialog class="dialog" id="dialog-recall" data-editor-target="dialog">
    {{ _self.dialog('recall', 'Recall preset') }}
    <form class="dialog__form" data-action="editor#recall">
        <label>Preset <select name="number" data-editor-target="slots" data-first="0"></select></label>
        <p class="dialog__note">A recall replaces all live settings.</p>
        <div class="dialog__buttons"><button type="submit" class="big">Recall</button></div>
    </form>
</dialog>

<dialog class="dialog" id="dialog-link" data-editor-target="dialog">
    {{ _self.dialog('link', 'Link') }}
    <form class="dialog__form" data-action="editor#link">
        <p class="dialog__note">Channels with the same group number are linked. The first channel of a group is copied to the others.</p>
        {% for side, prefix in {inputs: 'In', outputs: 'Out'} %}
            <div class="link-grid">
                {% for i in 0..7 %}
                    <label>{{ w.ch('inputs' == side ? i : 8 + i) }}
                        <select name="{{ side }}-{{ i }}" data-editor-target="linkGroup" data-side="{{ side }}" data-index="{{ i }}">
                            <option value="0">–</option>
                            {% for g in 1..4 %}<option value="{{ g }}">{{ g }}</option>{% endfor %}
                        </select>
                    </label>
                {% endfor %}
            </div>
        {% endfor %}
        <div class="dialog__buttons"><button type="submit" class="big">Apply</button></div>
    </form>
</dialog>

<dialog class="dialog" id="dialog-copy" data-editor-target="dialog">
    {{ _self.dialog('copy', 'Copy channel') }}
    <form class="dialog__form" data-action="editor#copy">
        <label>From <select name="source">{% for c in 0..15 %}{{ w.ch_option(c) }}{% endfor %}</select></label>
        <label>To <select name="target">{% for c in 0..15 %}{{ w.ch_option(c) }}{% endfor %}</select></label>
        <p class="dialog__note">Copies every setting of an input to an input, or of an output to an output.</p>
        <div class="dialog__buttons"><button type="submit" class="big">Copy</button></div>
    </form>
</dialog>

<dialog class="dialog" id="dialog-lock" data-editor-target="dialog">
    {{ _self.dialog('lock', 'Lock') }}
    <p>The front panel PIN is not available yet. Setting and removing it will follow once it has been tested on the device.</p>
</dialog>

<dialog class="dialog" id="dialog-working" data-editor-target="dialog">
    {{ _self.dialog('working', 'Working Status') }}
    <p class="dialog__note">Memorize keeps the live settings through a power cycle. Forget starts with the last recalled preset. The device does not report this value.</p>
    {{ w.choice('Working status', 'working_status', [{command: 'workingStatus', args: {mode: '@working_status'}}], labels.WORKING_STATUS) }}
</dialog>

<dialog class="dialog" id="dialog-idip" data-editor-target="dialog">
    {{ _self.dialog('idip', 'Setting ID/IP') }}
    <label>Device ID {{ w.choice('Device ID', 'device_id', [{command: 'deviceId', args: {id: '@device_id'}}], device_ids) }}</label>
    <p>IP address {{ w.value('ip') }}</p>
    <p class="dialog__note">The IP address can only be read. It is changed on the device.</p>
</dialog>

<dialog class="dialog" id="dialog-tone" data-editor-target="dialog">
    {{ _self.dialog('tone', 'Test Tone') }}
    {% set tone = [{command: 'testTone', args: {mode: '@tone_mode', freqIndex: '@tone_freq'}}] %}
    <label>Source {{ w.choice('Test tone source', 'tone_mode', tone, labels.TONE_MODES) }}</label>
    <label>Sine frequency {{ w.choice('Sine frequency', 'tone_freq', tone, labels.TONE_FREQUENCIES) }}</label>
    <p class="dialog__note">The tone plays on every routed output. Set the source back to Analog Input when done.</p>
</dialog>

<dialog class="dialog dialog--wide" id="dialog-names" data-editor-target="dialog">
    {{ _self.dialog('names', 'Channel Name') }}
    <div class="names">
        {% for side, prefix in {inputs: 'In', outputs: 'Out'} %}
            {% for i in 0..7 %}
                {% set channel = 'inputs' == side ? i : 8 + i %}
                <label>{{ prefix }}{{ i + 1 }} {{ w.text(prefix ~ (i + 1) ~ ' name', side ~ '.' ~ i ~ '.name', [{command: 'channelName', args: {channel: channel, name: '@' ~ side ~ '.' ~ i ~ '.name'}}], 8) }}</label>
            {% endfor %}
        {% endfor %}
        <label>Aux {{ w.text('Aux name', 'aux.name', [{command: 'channelName', args: {channel: 18, name: '@aux.name'}}], 8) }}</label>
    </div>
</dialog>

{% for key, title in {sub: 'Sub Control', groups: 'Group Control'} %}
    <dialog class="dialog dialog--wide" id="dialog-{{ key }}" data-editor-target="dialog">
        {{ _self.dialog(key, title) }}
        {{ include('editor/_subgroup.html.twig', {key: key}) }}
    </dialog>
{% endfor %}

<dialog class="dialog dialog--wide" id="dialog-auxcomp" data-editor-target="dialog">
    {{ _self.dialog('auxcomp', 'Aux compressor') }}
    {{ include('editor/page/_compressor.html.twig', {p: 'aux', channel: 18, meter: 16}) }}
</dialog>

{% for key, spec in {automix: ['AutoMix Setting', 18], camera: ['Camera Setting', 19]} %}
    {% set m = 'aux.' ~ key %}
    {% set send = [{command: 'mixFunction', args: {channel: spec[1], attack: '@' ~ m ~ '.attack', release: '@' ~ m ~ '.release', threshold: '@' ~ m ~ '.threshold', select: '@' ~ m ~ '.select', on: '@' ~ m ~ '.on'}}] %}
    <dialog class="dialog dialog--wide" id="dialog-{{ key }}" data-editor-target="dialog">
        {{ _self.dialog(key, spec[0]) }}
        {% if 'automix' == key %}
            <label>Slope {{ w.choice('AutoMix slope', 'aux.automix_slope', [{command: 'autoMixSlope', args: {index: '@aux.automix_slope'}}], labels.AUTOMIX_SLOPES) }}</label>
        {% endif %}
        <div class="strip__row">
            {{ w.fader('Threshold', m ~ '.threshold', send, 0, 180, 'threshold') }}
            {{ w.fader('Attack', m ~ '.attack', send, 0, 998, 'ms') }}
            {{ w.fader('Release', m ~ '.release', send, 0, 2999, 'ms') }}
            <fieldset class="group">
                <legend>Select</legend>
                {% for i in 0..7 %}
                    {{ w.toggle(w.ch(i), m ~ '.select', send, null, {bit: i, class: 'toggle--route'}) }}
                {% endfor %}
            </fieldset>
        </div>
    </dialog>
{% endfor %}

<dialog class="dialog dialog--wide" id="dialog-effect" data-editor-target="dialog">
    {{ _self.dialog('effect', 'Effect Setting') }}
    {% set e = 'aux.effect' %}
    {% set echo = [{command: 'echo', args: {predelay: '@' ~ e ~ '.echo_predelay', delay: '@' ~ e ~ '.echo_delay', repeat: '@' ~ e ~ '.echo_repeat', level: '@' ~ e ~ '.echo'}}] %}
    {% set reverb = [{command: 'reverb', args: {predelay: '@' ~ e ~ '.rev_predelay', reflect: '@' ~ e ~ '.reflect', time: '@' ~ e ~ '.time', level: '@' ~ e ~ '.reverb'}}] %}
    <div class="strip__row">
        {{ w.fader('Echo', e ~ '.echo', echo, 0, 100, 'raw') }}
        {{ w.fader('Repeat', e ~ '.echo_repeat', echo, 0, 100, 'raw') }}
        {{ w.fader('Delay', e ~ '.echo_delay', echo, 0, 1000, 'plainMs') }}
        {{ w.fader('PreDelay', e ~ '.echo_predelay', echo, 0, 200, 'plainMs') }}
        {{ w.fader('Reverb', e ~ '.reverb', reverb, 0, 100, 'raw') }}
        {{ w.fader('Reflect', e ~ '.reflect', reverb, 0, 100, 'raw') }}
        {{ w.fader('Time', e ~ '.time', reverb, 0, 255, 'reverbTime') }}
        {{ w.fader('Predelay', e ~ '.rev_predelay', reverb, 0, 200, 'plainMs') }}
        {{ w.fader('Gain', e ~ '.gain', [{command: 'effect', args: {on: '@' ~ e ~ '.on', gain: '@' ~ e ~ '.gain'}}], 0, 100, 'raw', null, {class: 'fader--tall'}) }}
    </div>
</dialog>

<dialog class="dialog dialog--wide" id="dialog-help" data-editor-target="dialog">
    {{ _self.dialog('help', 'RS232 Code Table') }}
    <p>RS232/485 remote control, manual chapter 6.1. 115200 baud, 8N1, at least 200 ms between packets.
        A packet is <code>7B 7D ID CMD D1 D2 D3 7D 7B</code>. These command numbers do not apply over USB or TCP.</p>
    <table class="table">
        <thead><tr><th>CMD</th><th>Function</th><th>Data</th></tr></thead>
        <tbody>
            <tr><td>40 / 43</td><td>Recall preset</td><td>F:0/U:1, number, 0</td></tr>
            <tr><td>41 / 54</td><td>Gain step up/down</td><td>In:0/Out:1, channel, up:0/down:1</td></tr>
            <tr><td>42</td><td>Mute</td><td>In/Out, channel, 0/1</td></tr>
            <tr><td>44 / 45</td><td>Volume In / Out</td><td>channel, HI, LO (280 = 0 dB)</td></tr>
            <tr><td>46 / 47 / 4C</td><td>Sub volume %, step, mute</td><td>In/Out, …</td></tr>
            <tr><td>48 / 49 / 4A / 4B / 4D</td><td>Read gain / mute / preset / sub / level</td><td>…</td></tr>
            <tr><td>4E / 4F</td><td>Set / read matrix</td><td>output, input, 0/1</td></tr>
            <tr><td>51 / 52 / 53</td><td>Aux gain step / mute / volume</td><td>02, …</td></tr>
            <tr><td>55</td><td>Effect/Camera/AutoMix on/off</td><td>02, 0/1/2, 0/1</td></tr>
            <tr><td>56</td><td>Aux source selection</td><td>0/1/2, mask hi, mask lo</td></tr>
            <tr><td>57 / 5E</td><td>Set / read FBQ</td><td>00, channel, 0–4</td></tr>
            <tr><td>58 / 59 / 5B / 5C</td><td>Read Aux</td><td>…</td></tr>
        </tbody>
    </table>
</dialog>

<dialog class="dialog" id="dialog-about" data-editor-target="dialog">
    {{ _self.dialog('about', 'About') }}
    <p><b>trackdsp</b>: free control software for the Thomann t.racks 8x8 Matrix DSP over USB (HID) and TCP port 9761.</p>
    <p>Not affiliated with Thomann. The protocol is described in <code>docs/protocol.md</code>.</p>
</dialog>
