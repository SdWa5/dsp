{% import 'editor/_widgets.html.twig' as w %}
{# tip: a key under editor.tip.panel whose text shows on hover over the title #}
{% macro dialog(id, title, tip = null) %}
    <header class="dialog__head"><h2{% if tip %} title="{{ ('editor.tip.panel.' ~ tip)|trans }}"{% endif %}>{{ title|trans }}</h2><button type="button" class="dialog__close" data-action="editor#close" aria-label="{{ "Close"|trans }}">×</button></header>
{% endmacro %}

<dialog class="dialog" id="dialog-connect" data-editor-target="dialog">
    {{ _self.dialog('connect', 'Connection', 'connect') }}
    <p class="dialog__status" data-editor-target="status">–</p>
    <form class="dialog__form" data-action="editor#connectTo">
        <label>{{ "Target"|trans }} <input type="text" name="target" data-editor-target="target" placeholder="{{ "auto, 192.168.68.10 or usb"|trans }}" required></label>
        <div class="dialog__buttons">
            <button type="button" class="big" data-action="editor#scan" data-editor-target="scanButton">{{ "Scan"|trans }}</button>
            <button type="submit" class="big">{{ "Connect"|trans }}</button>
            <button type="button" class="big" data-action="editor#connectDemo" title="{{ 'editor.tip.demo'|trans }}">{{ "Demo"|trans }}</button>
            <button type="button" class="big" data-action="editor#disconnectDevice">{{ "Disconnect"|trans }}</button>
        </div>
    </form>
    <p class="dialog__note" data-editor-target="scanStatus" hidden></p>
    <ul class="found" data-editor-target="found"></ul>
    <p class="dialog__note">{{ "\"auto\" connects to the first device found, USB before the network. Disconnect frees the device's connection, and the vendor editor may take it at once."|trans }}</p>
</dialog>

<dialog class="dialog" id="dialog-store" data-editor-target="dialog">
    {{ _self.dialog('store', 'Store preset', 'store') }}
    <form class="dialog__form" data-action="editor#store">
        <label>{{ "Slot"|trans }} <select name="number" data-editor-target="slots" data-first="1"></select></label>
        <label>{{ "Name"|trans }} <input type="text" name="name" maxlength="14" required data-editor-target="storeName"></label>
        <p class="dialog__note">{{ "The live settings and the running gain riders replace the slot. Every store is confirmed first."|trans }}</p>
        <div class="dialog__buttons"><button type="submit" class="big">{{ "Store"|trans }}</button></div>
    </form>
</dialog>

<dialog class="dialog" id="dialog-recall" data-editor-target="dialog">
    {{ _self.dialog('recall', 'Recall preset', 'recall') }}
    <form class="dialog__form" data-action="editor#recall">
        <label>{{ "Preset"|trans }} <select name="number" data-editor-target="slots" data-first="0"></select></label>
        <p class="dialog__note">{{ "A recall replaces all live settings and the gain riders."|trans }}</p>
        <div class="dialog__buttons"><button type="submit" class="big">{{ "Recall"|trans }}</button></div>
    </form>
</dialog>

<dialog class="dialog dialog--wide" id="dialog-link" data-editor-target="dialog">
    {{ _self.dialog('link', 'Link', 'link') }}
    <form class="dialog__form" data-action="editor#link">
        <p class="dialog__note">{{ "A cell links its row and column channel, and linked channels form a group, which lights as a block. A lit cell takes the column channel out of its group. The lowest channel of a group is copied to the others. The rows and columns follow the placement below."|trans }}</p>
        <div class="link-matrices">
        {% for side, prefix in {inputs: 'In', outputs: 'Out'} %}
            {% set base = 'inputs' == side ? 0 : 8 %}
            <div class="matrix-wrap">
            <table class="matrix link-matrix" data-editor-target="linkMatrix" data-side="{{ side }}">
                <thead>
                    <tr><th></th>{% for k in 0..7 %}<th scope="col" data-index="{{ k }}">{{ w.ch(base + k, {link: false}) }}</th>{% endfor %}</tr>
                </thead>
                <tbody>
                    {% for i in 0..7 %}
                        <tr data-index="{{ i }}">
                            <th scope="row" data-index="{{ i }}">{{ w.ch(base + i, {link: false}) }}</th>
                            {% for k in 0..7 %}
                                <td data-index="{{ k }}"><button type="button" class="toggle toggle--cell link-cell" data-side="{{ side }}" data-row="{{ i }}" data-column="{{ k }}"
                                        aria-label="{{ '%row% with %column%'|trans({'%row%': prefix ~ (i + 1), '%column%': prefix ~ (k + 1)}) }}"{{ i == k ? ' disabled' }} data-action="editor#linkCell"></button></td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        {% endfor %}
        </div>
        <fieldset class="link-view link-names">
            <span class="link-view__heading">{{ 'editor.link_view.names'|trans }}</span>
            <span class="link-names__list" data-editor-target="linkNames"></span>
            <span class="link-names__empty" data-editor-target="linkNamesEmpty">{{ 'editor.link_view.no_groups'|trans }}</span>
        </fieldset>
        <fieldset class="link-view">
            {{ include('editor/_linkview.html.twig', {name: 'link-dialog-placement', heading: 'link-view__heading', check: 'check'}) }}
        </fieldset>
        <div class="dialog__buttons"><button type="submit" class="big">{{ "Apply"|trans }}</button></div>
    </form>
</dialog>

<dialog class="dialog" id="dialog-copy" data-editor-target="dialog">
    {{ _self.dialog('copy', 'Copy channel', 'copy') }}
    <form class="dialog__form" data-action="editor#copy">
        <label>{{ "From"|trans }} <select name="source">{% for c in 0..15 %}{{ w.ch_option(c) }}{% endfor %}</select></label>
        <label>{{ "To"|trans }} <select name="target">{% for c in 0..15 %}{{ w.ch_option(c) }}{% endfor %}</select></label>
        <p class="dialog__note">{{ "Copies every setting of an input to an input, or of an output to an output."|trans }}</p>
        <div class="dialog__buttons"><button type="submit" class="big">{{ "Copy"|trans }}</button></div>
    </form>
</dialog>

<dialog class="dialog" id="dialog-lock" data-editor-target="dialog">
    {{ _self.dialog('lock', 'Lock', 'lock') }}
    <p>{{ "The front panel PIN is not available yet. Setting and removing it will follow once it has been tested on the device."|trans }}</p>
</dialog>

<dialog class="dialog" id="dialog-working" data-editor-target="dialog">
    {{ _self.dialog('working', 'Working Status', 'working') }}
    <p class="dialog__note">{{ "Memorize keeps the live settings through a power cycle. Forget starts with the last recalled preset. The device does not report this value."|trans }}</p>
    {{ w.choice('Working status', 'working_status', [{command: 'workingStatus', args: {mode: '@working_status'}}], labels.WORKING_STATUS) }}
</dialog>

<dialog class="dialog" id="dialog-idip" data-editor-target="dialog">
    {{ _self.dialog('idip', 'Setting ID/IP', 'idip') }}
    <label>{{ "Device ID"|trans }} {{ w.choice('Device ID', 'device_id', [{command: 'deviceId', args: {id: '@device_id'}}], device_ids) }}</label>
    <p>{{ "IP address"|trans }} {{ w.value('ip') }}</p>
    <p class="dialog__note">{{ "The IP address can only be read. It is changed on the device."|trans }}</p>
</dialog>

<dialog class="dialog" id="dialog-tone" data-editor-target="dialog">
    {{ _self.dialog('tone', 'Test Tone', 'tone') }}
    {% set tone = [{command: 'testTone', args: {mode: '@tone_mode', freqIndex: '@tone_freq'}}] %}
    <label>{{ "Source"|trans }} {{ w.choice('Test tone source', 'tone_mode', tone, labels.TONE_MODES) }}</label>
    <label>{{ "Sine frequency"|trans }} {{ w.choice('Sine frequency', 'tone_freq', tone, labels.TONE_FREQUENCIES) }}</label>
    <p class="dialog__note">{{ "The tone plays on every routed output. Set the source back to Analog Input when done."|trans }}</p>
</dialog>

<dialog class="dialog dialog--wide" id="dialog-names" data-editor-target="dialog">
    {{ _self.dialog('names', 'Channel Name', 'names') }}
    {{ include('editor/_channelnames.html.twig') }}
</dialog>

{% for key, title in {sub: 'Sub Control', groups: 'Group Control'} %}
    <dialog class="dialog dialog--wide" id="dialog-{{ key }}" data-editor-target="dialog">
        {{ _self.dialog(key, title, key) }}
        {{ include('editor/_subgroup.html.twig', {key: key}) }}
    </dialog>
{% endfor %}

<dialog class="dialog dialog--wide" id="dialog-auxcomp" data-editor-target="dialog">
    {{ _self.dialog('auxcomp', 'Aux compressor', 'aux_comp_dialog') }}
    {# The faders with the curve beside them, as in the vendor's Compressor Setting dialog #}
    <div class="dynamics-row">
        {{ include('editor/page/_compressor.html.twig', {p: 'aux', channel: 18, meter: 16, attack_max: 199, release_max: 998}) }}
        {{ w.dynamics('comp', 'aux', {class: 'dynamics--dialog'}) }}
    </div>
</dialog>

{% for key, spec in {automix: ['AutoMix Setting', 18], camera: ['Camera Setting', 19]} %}
    {% set m = 'aux.' ~ key %}
    {% set send = [{command: 'mixFunction', args: {channel: spec[1], attack: '@' ~ m ~ '.attack', release: '@' ~ m ~ '.release', threshold: '@' ~ m ~ '.threshold', select: '@' ~ m ~ '.select', on: '@' ~ m ~ '.on'}}] %}
    <dialog class="dialog dialog--wide" id="dialog-{{ key }}" data-editor-target="dialog">
        {{ _self.dialog(key, spec[0], key) }}
        {% if 'automix' == key %}
            <label>{{ "Slope"|trans }} {{ w.choice('AutoMix slope', 'aux.automix_slope', [{command: 'autoMixSlope', args: {index: '@aux.automix_slope'}}], labels.AUTOMIX_SLOPES) }}</label>
        {% endif %}
        <div class="strip__row">
            {{ w.fader('Threshold', m ~ '.threshold', send, 80, 180, 'threshold') }}
            {{ w.fader('Attack', m ~ '.attack', send, 0, 998, 'ms') }}
            {{ w.fader('Release', m ~ '.release', send, 0, 2999, 'ms') }}
            <fieldset class="group" data-controller="linkplace selectors">
                <legend>{{ "Select"|trans }}</legend>
                {% for i in 0..7 %}
                    {{ w.toggle(w.ch(i), m ~ '.select', send, null, {bit: i, class: 'toggle--route'}) }}
                {% endfor %}
            </fieldset>
        </div>
    </dialog>
{% endfor %}

<dialog class="dialog dialog--wide" id="dialog-effect" data-editor-target="dialog">
    {{ _self.dialog('effect', 'Effect Setting', 'effect') }}
    {% set e = 'aux.effect' %}
    {% set echo = [{command: 'echo', args: {predelay: '@' ~ e ~ '.echo_predelay', delay: '@' ~ e ~ '.echo_delay', repeat: '@' ~ e ~ '.echo_repeat', level: '@' ~ e ~ '.echo'}}] %}
    {% set reverb = [{command: 'reverb', args: {predelay: '@' ~ e ~ '.rev_predelay', reflect: '@' ~ e ~ '.reflect', time: '@' ~ e ~ '.time', level: '@' ~ e ~ '.reverb'}}] %}
    <div class="strip__row">
        {{ w.fader('Echo', e ~ '.echo', echo, 0, 100, 'raw') }}
        {{ w.fader('Repeat', e ~ '.echo_repeat', echo, 0, 100, 'raw') }}
        {{ w.fader('Delay', e ~ '.echo_delay', echo, 0, 400, 'plainMs') }}
        {{ w.fader('PreDelay', e ~ '.echo_predelay', echo, 0, 200, 'plainMs') }}
        {{ w.fader('Reverb', e ~ '.reverb', reverb, 0, 100, 'raw') }}
        {{ w.fader('Reflect', e ~ '.reflect', reverb, 0, 100, 'raw') }}
        {{ w.fader('Time', e ~ '.time', reverb, 0, 255, 'reverbTime') }}
        {{ w.fader('Predelay', e ~ '.rev_predelay', reverb, 0, 200, 'plainMs') }}
        {{ w.fader('Gain', e ~ '.gain', [{command: 'effect', args: {on: '@' ~ e ~ '.on', gain: '@' ~ e ~ '.gain'}}], 0, 100, 'raw', null, {class: 'fader--tall'}) }}
    </div>
</dialog>

<dialog class="dialog dialog--wide" id="dialog-help" data-editor-target="dialog">
    {{ _self.dialog('help', 'RS232 Code Table', 'help') }}
    <p>{{ "RS232/485 remote control, manual chapter 6.1. 115200 baud, 8N1, at least 200 ms between packets. A packet is"|trans }} <code>7B 7D ID CMD D1 D2 D3 7D 7B</code>{{ ". These command numbers do not apply over USB or TCP."|trans }}</p>
    <fieldset class="dialog__form" data-controller="serial" data-action="input->serial#render change->serial#render">
        <legend>{{ 'RS232 command builder'|trans }}</legend>
        <label>{{ 'Command'|trans }} <select data-serial-target="command" data-action="change->serial#select"></select></label>
        <label>{{ 'Device ID'|trans }} <input type="number" min="1" max="254" step="1" value="1" data-serial-target="id"></label>
        <div class="form-grid" data-serial-target="params"></div>
        <label>{{ 'Remote control code'|trans }} <input type="text" readonly data-serial-target="packet"></label>
        <p role="status" data-serial-target="error" hidden>{{ 'Enter whole numbers within the ranges. Factory uses preset 0; User uses presets 1 to 20.'|trans }}</p>
        <p class="dialog__note">{{ 'The code is generated locally. Select the text to copy it. Input mask bits 0 to 7 select In1 to In8. Raw command accepts decimal CMD and data bytes for commands without a named entry.'|trans }}</p>
    </fieldset>
    <table class="table">
        <thead><tr><th>CMD</th><th>{{ "Function"|trans }}</th><th>{{ "Data"|trans }}</th></tr></thead>
        <tbody>
            <tr><td>40 / 43</td><td>{{ "Recall preset"|trans }}</td><td>{{ "F:0/U:1, number, 0"|trans }}</td></tr>
            <tr><td>41 / 54</td><td>{{ "Gain step up/down"|trans }}</td><td>{{ "In:0/Out:1, channel, up:0/down:1"|trans }}</td></tr>
            <tr><td>42</td><td>{{ "Mute"|trans }}</td><td>{{ "In/Out, channel, 0/1"|trans }}</td></tr>
            <tr><td>44 / 45</td><td>{{ "Volume In / Out"|trans }}</td><td>{{ "channel, HI, LO (280 = 0 dB)"|trans }}</td></tr>
            <tr><td>46 / 47 / 4C</td><td>{{ "Sub volume %, step, mute"|trans }}</td><td>In/Out, …</td></tr>
            <tr><td>48 / 49 / 4A / 4B / 4D</td><td>{{ "Read gain / mute / preset / sub / level"|trans }}</td><td>…</td></tr>
            <tr><td>4E / 4F</td><td>{{ "Set / read matrix"|trans }}</td><td>{{ "output, input, 0/1"|trans }}</td></tr>
            <tr><td>51 / 52 / 53</td><td>{{ "Aux gain step / mute / volume"|trans }}</td><td>02, …</td></tr>
            <tr><td>55</td><td>{{ "Effect/Camera/AutoMix on/off"|trans }}</td><td>02, 0/1/2, 0/1</td></tr>
            <tr><td>56</td><td>{{ "Aux source selection"|trans }}</td><td>{{ "0/1/2, mask hi, mask lo"|trans }}</td></tr>
            <tr><td>57 / 5E</td><td>{{ "Set / read FBQ"|trans }}</td><td>{{ "00, channel, 0–4"|trans }}</td></tr>
            <tr><td>58 / 59 / 5B / 5C</td><td>{{ "Read Aux"|trans }}</td><td>…</td></tr>
        </tbody>
    </table>
</dialog>

<dialog class="dialog" id="dialog-about" data-editor-target="dialog">
    {{ _self.dialog('about', 'About', 'about') }}
    <p><b>trackdsp</b>{{ ": free control software for the Thomann t.racks 8x8 Matrix DSP over USB (HID) and TCP port 9761."|trans }}</p>
    <p>{{ 'Version'|trans }} <span data-app-version>{{ version }}</span></p>
    <p>{{ "Not affiliated with Thomann. The protocol is described in"|trans }} <code>docs/protocol.md</code>.</p>
</dialog>

<dialog class="dialog dialog--wide presetfile" id="dialog-preset" data-editor-target="dialog" data-controller="presetfile" data-action="presetfile:open->presetfile#open">
    {{ _self.dialog('preset', 'Inspect preset file', 'preset_file') }}
    <p data-presetfile-target="name" class="presetfile__name"></p>
    <p class="dialog__note">{{ 'Inspecting this file does not change live settings. Unknown values are not stored in the file. Apply to device sends its settings after confirmation.'|trans }}</p>
    <p role="status" data-presetfile-target="message"></p>
    <label>{{ 'Section'|trans }} <select data-presetfile-target="section" data-action="change->presetfile#select"></select></label>
    <div class="presetfile__table"><table class="table"><thead><tr><th>{{ 'Setting'|trans }}</th><th>{{ 'Value'|trans }}</th></tr></thead><tbody data-presetfile-target="rows"></tbody></table></div>
    <div class="dialog__buttons"><button type="button" class="big" data-presetfile-target="apply" data-action="presetfile#apply" disabled>{{ 'Apply to device'|trans }}</button></div>
</dialog>
