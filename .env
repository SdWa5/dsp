# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> sdwa5-dsp ###
# auto (USB first, then the network), usb, usb:/dev/hidrawN, demo or host[:port]
SDWA5_DSP_TARGET=auto
# Where the USB search looks: the sysfs class directory and the directory holding the hidraw device nodes.
# ddev mounts the host's /dev at /run/host-dev.
SDWA5_DSP_HIDRAW_SYSFS=/sys/class/hidraw
SDWA5_DSP_HIDRAW_DEV=/dev
# ALSA capture device of the auto EQ and sdwa5-dsp:measure when none is given, e.g. plughw:CARD=UMC1820,DEV=0.
# "default" is the first sound card, inside ddev the laptop's own codec.
SDWA5_DSP_CAPTURE_DEVICE=default
###< sdwa5-dsp ###

###> sdwa5-dsp/web ###
# Host names the web editor answers to (regular expression). Guards against DNS rebinding.
# A ddev with another project TLD adds its host in .env.local.
SDWA5_DSP_TRUSTED_HOSTS='^(localhost|127\.0\.0\.1|\[::1\]|[a-z0-9-]+\.ddev\.site)$'

# Networks the "auto" target and the Scan button search, comma-separated CIDRs such as
# 192.168.68.0/22. Empty: the networks of the local interfaces. A ddev container only sees its
# own network, so ddev sets the LAN here in .env.local.
SDWA5_DSP_DISCOVERY_NETWORKS=

# Language of the browser editor, en or de. Empty: the browser's language. The Language menu overrides it per browser.
SDWA5_DSP_LOCALE=
###< sdwa5-dsp/web ###
