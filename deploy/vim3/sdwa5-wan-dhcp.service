[Unit]
Description=Serve DHCP on end0 when no other DHCP server answers (Deco WAN port)
Documentation=file:///srv/trackdsp/docs/vim3.md
After=systemd-networkd.service
Requires=systemd-networkd.service

[Service]
ExecStart=/usr/local/sbin/sdwa5-wan-dhcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
