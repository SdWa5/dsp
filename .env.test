# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SDWA5_DSP_TARGET=demo
# Nothing listens on 127.0.0.1:9761 in the tests, so the scan finds nothing and stays fast
SDWA5_DSP_DISCOVERY_NETWORKS=127.0.0.1/32
# No USB search on the machine running the tests
SDWA5_DSP_HIDRAW_SYSFS=/nonexistent
