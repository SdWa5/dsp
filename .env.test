# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
TRACKDSP_TARGET=demo
# Nothing listens on 127.0.0.1:9761 in the tests, so the scan finds nothing and stays fast
TRACKDSP_DISCOVERY_NETWORKS=127.0.0.1/32
# No USB search on the machine running the tests
TRACKDSP_HIDRAW_SYSFS=/nonexistent
